# Copy to .env for local development (never commit the real .env — it's gitignored).
# python-dotenv is NOT a dependency here; export these in your shell instead, e.g.:
#   set -a; source .env; set +a        (bash)
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { Set-Item -Path "env:$($matches[1])" -Value $matches[2] } }   (PowerShell)

# Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password-here'))"
ADMIN_PASSWORD_HASH=

# Any long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
